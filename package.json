{
  "name": "billing-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-pwa.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node tests/run-dc-tests.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "migrate": "node scripts/apply-migrations.mjs",
    "migrate:check": "node scripts/validate-migrations.mjs",
    "db:audit": "node scripts/audit-schema.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:which": "node scripts/which-db.mjs",
    "test:escape-probe": "node scripts/escape-probe-test.mjs",
    "seed:dc": "node scripts/seed-dc.mjs",
    "seed:job-work": "node scripts/seed-job-work.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@neon/config": "^1.8.4",
    "@neon/functions": "^0.11.0",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
