# Browser-safe configuration. Never put a secret behind a VITE_ prefix.
# Neon database base URL (https://<endpoint>/<database>, no credentials, no query string).
VITE_NEON_DATABASE_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<database>
# Deployed Neon Function URLs (from: neon functions get api / neon functions get process-bill)
VITE_NEON_API_URL=https://<endpoint>-api.compute.<region>.aws.neon.tech
VITE_NEON_PROCESS_BILL_URL=https://<endpoint>-processbill.compute.<region>.aws.neon.tech


# ---- Server-only. NEVER commit real values. Used by Neon Functions / migrations only. ----
# Injected automatically by Neon at runtime; do not redeclare:
#   DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL,
#   NEON_DATA_API_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION
# Direct/unpooled connection string used for schema migrations only.
# Put your own credentials here (or in .env, which must stay out of version control):
#   neon branches url --pooled=false
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# OCR.space API key (process-bill function only). Get one at https://www.ocr.space/ocrapi
OCR_API_KEY=<your OCR.space API key>
# Exact SPA origins allowed to call the Neon Functions (no trailing slash).
# Comma-separate several, e.g. the live site and http://localhost:5173.
WEB_ORIGIN=http://localhost:5173

